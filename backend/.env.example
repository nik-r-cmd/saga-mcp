# Copy to .env and add the Supabase project settings. ES256/RS256 tokens
# are verified against the project's published JWKS endpoint.
SUPABASE_PROJECT_ID=your-project-ref
SUPABASE_URL=https://your-project-ref.supabase.co

# Only needed for legacy HS256-signed Supabase tokens.
# SUPABASE_JWT_SECRET=replace-with-your-legacy-jwt-secret

# Defaults to this local Ollama endpoint and model if omitted.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
